<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12+ system splash. The platform paints `windowSplashScreenBackground`
        full-screen and centres `windowSplashScreenAnimatedIcon` on top, which
        eliminates the "blue-only / no-logo" first splash. We point the icon at
        the adaptive-icon foreground (UW + lightning, transparent) so it shows
        seamlessly before the Compose SplashScreen takes over.
    -->
    <style name="Theme.UniWatt.Splash" parent="@android:style/Theme.Material.Light.NoActionBar">
        <!--
            The Android 12+ "splash icon" slot is hard-coded to a circular
            mask, which clips the rectangular UniWatt mark. To avoid that we:
              1) leave the system splash icon unset (shows just splash_bg),
              2) point windowBackground at the full-logo layer-list, so the
                 instant the system splash fades out the activity background
                 shows the WHOLE image centred — no circle mask.
            See drawable/splash_screen.xml.
        -->
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <!--
            Show the UniWatt mark on the system splash itself so there is NO
            "blank blue" first frame before windowBackground takes over.
            The platform clips this icon to a circular safe-zone (~2/3 of the
            canvas), so `splash_icon.xml` wraps the logo in an <inset> to keep
            the art comfortably inside that zone — no edge cutting, no
            duplicate launcher icon.
        -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
    </style>
</resources>
