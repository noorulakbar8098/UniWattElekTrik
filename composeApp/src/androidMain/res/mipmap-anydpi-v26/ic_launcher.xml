<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon (API 26+).

    The foreground is wrapped in a negative-inset so the UW logo bitmap is
    rendered ~15% larger than the default 72dp safe zone — gives the launcher
    icon a tighter, more confident look (the user asked for a slight zoom).
    Negative insets are clipped by the launcher's mask (circle / squircle /
    rounded square) so this stays within bounds on every OEM.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground>
        <inset
            android:drawable="@mipmap/ic_launcher_foreground"
            android:inset="10dp" />
    </foreground>
</adaptive-icon>

