rules_version = '2';
// UniWatt ElekTrik — production Firestore rules.
//
// Data model:
//   admins/{adminId}                                        ← admin profile
//   admins/{adminId}/users/{userId}                         ← employees
//   admins/{adminId}/users/{userId}/attendance/{id}         ← per-user attendance
//   admins/{adminId}/tasks/{taskId}
//   admins/{adminId}/checkins/{checkinId}                   ← location pings
//   admins/{adminId}/inventory/{itemId}
//   employee_map/{userId}                                   ← { adminId, mustChangePassword }
service cloud.firestore {
  match /databases/{database}/documents {
    // Employee → admin lookup, written during Add Employee, read by the
    // employee on first sign-in.
    match /employee_map/{userId} {
      allow read:  if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null;
    }
    match /admins/{adminId} {
      // Admin owns their entire tree.
      allow read, write: if request.auth != null && request.auth.uid == adminId;
      match /users/{userId} {
        // Admin can manage every employee.
        allow read, write:  if request.auth != null && request.auth.uid == adminId;
        // Employee can read & update their own profile doc.
        allow read, update: if request.auth != null && request.auth.uid == userId;
        // Per-user attendance (nested under each employee)
        match /attendance/{attendanceId} {
          // Admin sees & manages everyone's attendance.
          allow read, write:          if request.auth != null && request.auth.uid == adminId;
          // Owning employee can read, create, and update their own records.
          allow read, create, update: if request.auth != null && request.auth.uid == userId;
        }
      }
      match /tasks/{taskId} {
        allow read, write:  if request.auth != null && request.auth.uid == adminId;
        // Assigned employee can read & update their own task docs.
        allow read, update: if request.auth != null && exists(
          /databases/$(database)/documents/admins/$(adminId)/users/$(request.auth.uid)
        );
      }
      match /checkins/{checkinId} {
        allow read, write: if request.auth != null && request.auth.uid == adminId;
        allow create:      if request.auth != null && exists(
          /databases/$(database)/documents/admins/$(adminId)/users/$(request.auth.uid)
        );
      }
      match /inventory/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == adminId;
      }
    }
    // Collection-group rule so the admin attendance screen can query across
    // all users via collectionGroup("attendance").whereEqualTo("adminId", uid).
    match /{path=**}/attendance/{attendanceId} {
      allow read: if request.auth != null && resource.data.adminId == request.auth.uid;
    }
  }
}
