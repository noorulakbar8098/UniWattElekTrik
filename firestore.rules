rules_version = '2';
// UniWatt ElekTrik — production Firestore rules.
//
// IMPORTANT: This app uses FLAT TOP-LEVEL collections, all tenant-isolated by
// an `adminId` field on every document (see WorkforceDirectory.kt).
//
//   /admins/{adminId}                 ← admin profile
//   /users/{userId}                   ← employees   { adminId, ... }
//   /tasks/{taskId}                   ← tasks       { adminId, assignedUserId, ... }
//   /attendance_logs/{attendanceId}   ← attendance  { adminId, userId, ... }
//   /inventory_items/{itemId}         ← inventory   { adminId, ... }
//   /inventory_transactions/{txnId}   ← txns        { adminId, userId, ... }
//   /checkins/{checkinId}             ← gps pings   { adminId, userId, ... }
//   /notifications/{notificationId}   ← inbox       { adminId, userId, ... }
//   /spare_items/{itemId}             ← spares      { adminId, ... }
//   /departments/{deptId}             ← departments { adminId, name, ... }
//   /equipment/{equipmentId}          ← equipment   { adminId, departmentId, ... }
//   /leave_requests/{leaveId}         ← leave requests { adminId, userId, status, ... }
//   /employee_map/{userId}            ← auth lookup { adminId, mustChangePassword }
//   /admin_ids/{code}                 ← admin code lookup
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isAuthed()        { return request.auth != null; }
    function isAdminOf(id)     { return isAuthed() && request.auth.uid == id; }
    // Existing-doc tenant ownership: doc has `adminId` == caller.
    function ownsExisting()    { return isAuthed() && resource.data.adminId == request.auth.uid; }
    // Incoming-doc tenant ownership: caller is creating their own doc.
    function ownsIncoming()    { return isAuthed() && request.resource.data.adminId == request.auth.uid; }

    // ── Cloudinary URL validators ────────────────────────────────────────────
    // Ensures photoUrl is always a real Cloudinary URL (not a malicious link).
    function isValidPhotoUrl(url) {
      return url == ""
          || url.matches("https://res\\.cloudinary\\.com/dcxjmlivz/.*");
    }
    // Checks incoming photoUrl on a write is valid.
    function photoUrlIsValid() {
      return !("photoUrl" in request.resource.data)
          || isValidPhotoUrl(request.resource.data.photoUrl);
    }

    // ── Fields an employee may update on their OWN profile ───────────────────
    // Prevents employees from changing their salary, role, adminId, etc.
    function employeeSelfUpdateAllowed() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(["photoUrl", "fcmToken", "mustChangePassword",
                  "passwordChangedAt", "updatedAt"]);
    }

    // ── Auth lookup tables ─────────────────────────────────────────────────
    match /employee_map/{userId} {
      allow read:  if isAuthed();
      allow write: if isAuthed();
    }
    match /admin_ids/{code} {
      allow read:  if isAuthed();
      allow write: if isAuthed();
    }

    // ── Admin profile ──────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read, write: if isAdminOf(adminId);
    }

    // ── Employees (flat, tenant-isolated by adminId field) ─────────────────
    match /users/{userId} {
      // Admin — reads never touch request.resource so no photoUrlIsValid() here.
      allow read, delete, list: if ownsExisting();
      // Admin writes: validate photoUrl only on create / update (write ops).
      allow create:             if ownsIncoming() && photoUrlIsValid();
      allow update:             if ownsExisting() && photoUrlIsValid();

      // Employee can always read their own profile.
      allow read:               if isAuthed() && request.auth.uid == userId;
      // Employee self-update: limited safe fields only + valid photo URL.
      allow update:             if isAuthed()
                                  && request.auth.uid == userId
                                  && employeeSelfUpdateAllowed()
                                  && photoUrlIsValid();
    }

    // ── Tasks ──────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow create:         if ownsIncoming();
      allow read, update,
            delete, list:   if ownsExisting();
      // Assigned employee can read & update their own tasks
      // (e.g. accept, checklist, add attachments, complete with signoff).
      allow read, update:   if isAuthed() && resource.data.assignedUserId == request.auth.uid;

      // ── Notes subcollection (chat between admin & assigned user) ─────────
      // Both the owning admin AND the currently-assigned user may read,
      // create and modify notes on a task. Rules are evaluated against the
      // PARENT task doc via get() so the chat stays scoped to the same
      // tenant + assignee pair the rest of the app already enforces.
      match /notes/{noteId} {
        function parentTask() {
          return get(/databases/$(database)/documents/tasks/$(taskId)).data;
        }
        function isTaskAdmin() {
          return isAuthed() && parentTask().adminId == request.auth.uid;
        }
        function isTaskAssignee() {
          return isAuthed() && parentTask().assignedUserId == request.auth.uid;
        }
        allow read, list, create, update, delete:
            if isTaskAdmin() || isTaskAssignee();
      }
    }

    // ── Attendance ─────────────────────────────────────────────────────────
    match /attendance_logs/{attendanceId} {
      allow create:         if ownsIncoming()
                              || (isAuthed() && request.resource.data.userId == request.auth.uid);
      allow read, list:     if ownsExisting()
                              || (isAuthed() && resource.data.userId == request.auth.uid);
      allow update:         if ownsExisting()
                              || (isAuthed() && resource.data.userId == request.auth.uid);
      allow delete:         if ownsExisting();
    }

    // ── Inventory items / transactions ─────────────────────────────────────
    match /inventory_items/{itemId} {
      allow create:         if ownsIncoming();
      allow read, update,
            delete, list:   if ownsExisting();
    }
    match /inventory_transactions/{txnId} {
      allow create:         if ownsIncoming();
      allow read, update,
            delete, list:   if ownsExisting();
      allow read:           if isAuthed() && resource.data.userId == request.auth.uid;
    }

    // ── GPS check-ins ──────────────────────────────────────────────────────
    match /checkins/{checkinId} {
      allow create:         if ownsIncoming()
                              || (isAuthed() && request.resource.data.userId == request.auth.uid);
      allow read, update,
            delete, list:   if ownsExisting();
    }

    // ── Notifications ──────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow create:         if ownsIncoming();
      allow read, update,
            delete, list:   if ownsExisting()
                              || (isAuthed() && resource.data.userId == request.auth.uid);
    }

    // ── Spare items ────────────────────────────────────────────────────────
    match /spare_items/{itemId} {
      allow create:         if ownsIncoming();
      allow read, update,
            delete, list:   if ownsExisting();
    }

    // ── Leave requests ────────────────────────────────────────────────────
    // Employee can create & read their own requests (userId field).
    // Admin can read, update (approve/reject), and delete within their tenant.
    match /leave_requests/{leaveId} {
      allow create:         if ownsIncoming()
                              || (isAuthed() && request.resource.data.userId == request.auth.uid);
      allow read, list:     if ownsExisting()
                              || (isAuthed() && resource.data.userId == request.auth.uid);
      allow update:         if ownsExisting();
      allow delete:         if ownsExisting();
    }

    // ── Departments / Equipment ────────────────────────────────────────────
    match /departments/{deptId} {
      allow create:         if ownsIncoming();
      allow read, update,
            delete, list:   if ownsExisting();
    }
    match /equipment/{equipmentId} {
      allow create:         if ownsIncoming();
      allow read, update,
            delete, list:   if ownsExisting();
    }
  }
}

